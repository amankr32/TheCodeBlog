# MongoDB connection string
MONGO=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority

# Secret used to sign JSON Web Tokens - use a long random string
JWT_SECRET=replace-with-a-long-random-string

# Port the API listens on locally (Vercel ignores this in production)
PORT=3000

# Your deployed frontend URL - required in production for CORS to allow it
# e.g. https://your-app.vercel.app
CLIENT_URL=

# Set automatically to "production" on Vercel - leave unset for local dev
# NODE_ENV=production
